{
  "Navigation": {
    "ArrivalDistance": 2.0,
    "IdleTimeout": "00:00:01.300",
    "MaxStuckAttempts": 5,
    "StuckWindow": "00:00:30",
    "DisconnectTimeout": "00:00:15"
  },
  "Display": {
    "ScreenWidth": 1920,
    "ScreenHeight": 1080
  },
  "Vnc": {
    "Host": "localhost",
    "Port": 8010
  },
  "Routes": {
    "Directory": "./routes"
  },
  "WorldGraph": {
    "DataDirectory": "./gamedata"
  },
  "Protocol": {
    "Ports": [5056, 5055, 4535]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/oryxbot-.log", "rollingInterval": "Day" } }
    ]
  }
}
