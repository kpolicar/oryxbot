      </Compile>
      <Compile Update="TradeMissionRunRoute.cs">
        <DependentUpon>TradeMissionRun.cs</DependentUpon>
      </Compile>
      <Compile Update="TradeMissionTakeQuest.cs">
        <DependentUpon>TradeMissionRun.cs</DependentUpon>
      </Compile>
      <Compile Update="TradeMissionBank.cs">
        <DependentUpon>TradeMissionRun.cs</DependentUpon>
      </Compile>
      <Compile Update="TradeMissionMovementTracker.cs">
        <DependentUpon>TradeMissionRun.cs</DependentUpon>
      </Compile>
      <Compile Update="TradeMissionProgressQuest.cs">
        <DependentUpon>TradeMissionRun.cs</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Resources\route_lymhurst_bank_to_quest.csv" />
